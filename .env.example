# MongoDB Atlas connection string (required on Vercel)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vitacare?retryWrites=true&w=majority
# Any long random string (required on Vercel)
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Claude API key for the AI assistant (POST /api/ai/chat). Without it the app falls back to offline answers.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: change the model (default claude-haiku-5-5)
ANTHROPIC_MODEL=claude-haiku-5-5
